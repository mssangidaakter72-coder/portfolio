# ---- Node.js email backend (server / api) ----
# SMTP credentials used by Nodemailer. For Gmail use an "App Password".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password

# Who receives the contact form messages (usually the same as SMTP_USER)
CONTACT_TO_EMAIL=your.email@gmail.com

# Port for the local Express dev server
PORT=5000

# ---- Frontend (client) ----
# Base URL used for SEO canonical + Open Graph tags (set to your live domain)
VITE_SITE_URL=https://your-domain.vercel.app
